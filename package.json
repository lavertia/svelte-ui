{
  "name": "@lavertia/svelte-ui",
  "version": "0.1.0-alpha.1",
  "type": "module",
  "license": "MIT",
  "description": "Svelte 5 UI rendering for Lavertia",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "svelte-package --input src --output dist",
    "prepare": "npm run build",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run typecheck"
  },
  "dependencies": {
    "@lavertia/ui": "github:lavertia/ui#main"
  },
  "peerDependencies": {
    "@inertiajs/svelte": "^3.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@inertiajs/svelte": "^3.0.0",
    "svelte": "^5.0.0",
    "@sveltejs/package": "^2.3.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
